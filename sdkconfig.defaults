# Media playback is limited to local SD-card files.
CONFIG_ESP_PLAYER_ENABLE_FILE_IO=y
CONFIG_ESP_PLAYER_ENABLE_HTTP_IO=n
CONFIG_ESP_PLAYER_ENABLE_HLS_IO=n

# Match LVGL draw buffers to the ESP32-P4 L2 cache line for PPA.
CONFIG_LV_DRAW_BUF_ALIGN=128

# Video playback uses AVI/MJPEG with the ESP32-P4 hardware JPEG decoder.
CONFIG_AVI_EXTRACTOR_SUPPORT=y
CONFIG_MJPEG_EXTRACTOR_SUPPORT=y
CONFIG_MP4_EXTRACTOR_SUPPORT=n
CONFIG_VIDEO_DECODER_SW_H264_SUPPORT=n
CONFIG_VIDEO_DECODER_SW_MJPEG_SUPPORT=n
CONFIG_VIDEO_DECODER_HW_MJPEG_SUPPORT=y
CONFIG_ESP_MUXER_MP4_SUPPORT=n
CONFIG_VIDEO_ENCODER_HW_H264_SUPPORT=n
CONFIG_VIDEO_ENCODER_HW_H264_DUAL_SUPPORT=n
CONFIG_VIDEO_ENCODER_SW_H264_SUPPORT=n
CONFIG_VIDEO_ENCODER_HW_MJPEG_SUPPORT=n
CONFIG_VIDEO_ENCODER_SW_MJPEG_SUPPORT=n
